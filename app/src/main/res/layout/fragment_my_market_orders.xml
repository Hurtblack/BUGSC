<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hud_screen_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:text="SCM // MY ORDERS"
        android:textColor="@color/sc_accent"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="我的挂单"
        android:textColor="@color/sc_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_my_order_all"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="全部" />

        <Button
            android:id="@+id/btn_my_order_sell"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="出售" />

        <Button
            android:id="@+id/btn_my_order_buy"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="求购" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_my_orders_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="加载中…"
        android:textColor="@color/sc_text_dim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/container_my_orders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>

    <Button
        android:id="@+id/btn_my_orders_load_more"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:backgroundTint="@color/sc_panel2"
        android:minHeight="0dp"
        android:text="加载更多"
        android:textColor="@color/sc_text_mid"
        android:visibility="gone" />
</LinearLayout>

