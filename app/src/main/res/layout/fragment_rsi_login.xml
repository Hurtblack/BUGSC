<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hud_screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="RSI // ACCOUNT"
            android:textColor="@color/sc_accent"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="RSI 登录"
            android:textColor="@color/sc_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_username_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="用户名"
            android:textColor="@color/sc_text_dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg"
            android:hint="账号"
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_password_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="密码"
            android:textColor="@color/sc_text_dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg"
            android:hint="密码"
            android:inputType="textPassword"
            android:paddingHorizontal="10dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_captcha_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="图片验证码"
            android:textColor="@color/sc_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_captcha"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:background="@drawable/input_bg"
            android:contentDescription="RSI 图片验证码"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <EditText
            android:id="@+id/et_captcha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg"
            android:hint="输入图片中的验证码"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:paddingHorizontal="10dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_code_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="二步验证码"
            android:textColor="@color/sc_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/et_code"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg"
            android:hint="邮箱验证码，可包含英文字母"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:paddingHorizontal="10dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="请输入 RSI 账号密码登录"
            android:textColor="@color/sc_text_mid"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/sc_danger"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_inventory_primary"
            android:letterSpacing="0.08"
            android:paddingVertical="12dp"
            android:text="登录"
            android:textAllCaps="false"
            android:textColor="@color/sc_ink"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
