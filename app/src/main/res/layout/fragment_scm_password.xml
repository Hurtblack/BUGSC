<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hud_screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="SCM // PASSWORD"
            android:textColor="@color/sc_accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="重置密码"
            android:textColor="@color/sc_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 改密：旧密码 -->
        <EditText
            android:id="@+id/et_old_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/input_bg"
            android:hint="旧密码"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim"
            android:visibility="gone" />

        <!-- 忘密：邮箱 + 验证码 + 发码 + 邮箱码 -->
        <LinearLayout
            android:id="@+id/container_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_bg"
                android:hint="邮箱"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:textColor="@color/sc_text"
                android:textColorHint="@color/sc_text_dim" />

            <com.euedrc.bugsc.scm.ScmCaptchaView
                android:id="@+id/captcha_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg" />

            <Button
                android:id="@+id/btn_send_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_inventory_secondary"
                android:paddingVertical="10dp"
                android:text="发送邮箱验证码"
                android:textAllCaps="false"
                android:textColor="@color/sc_text"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_email_code"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_bg"
                android:hint="邮箱验证码"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/sc_text"
                android:textColorHint="@color/sc_text_dim" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_new_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_bg"
            android:hint="新密码"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/sc_text_mid"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/sc_danger"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_inventory_primary"
            android:paddingVertical="12dp"
            android:text="提交"
            android:textAllCaps="false"
            android:textColor="@color/sc_ink"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
