<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hud_screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="SCM // ACCOUNT"
            android:textColor="@color/sc_accent"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:letterSpacing="0.12"
            android:text="SCM 登录"
            android:textColor="@color/sc_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="邮箱"
            android:textColor="@color/sc_text_mid"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="12dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="密码"
            android:textColor="@color/sc_text_mid"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg"
            android:hint="密码"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim" />

        <com.euedrc.bugsc.scm.ScmCaptchaView
            android:id="@+id/captcha_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg" />

        <TextView
            android:id="@+id/tv_email_code_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="邮箱验证码（新设备需要）"
            android:textColor="@color/sc_text_mid"
            android:textSize="13sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/et_email_code"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg"
            android:hint="邮箱验证码"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/sc_text_mid"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/sc_danger"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_inventory_primary"
            android:paddingVertical="12dp"
            android:text="登录"
            android:textAllCaps="false"
            android:textColor="@color/sc_ink"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_register"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="6dp"
                android:text="去注册"
                android:textColor="@color/sc_accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_forgot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="end"
                android:paddingVertical="6dp"
                android:text="忘记密码"
                android:textColor="@color/sc_accent"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
