<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hud_screen_bg"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sc_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_agent_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sc_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_agent_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/sc_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_agent_new_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_outline_accent"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="@string/agent_new_chat"
                android:textAllCaps="false"
                android:textColor="@color/sc_accent"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_agent_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_outline_accent"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="@string/agent_settings"
                android:textAllCaps="false"
                android:textColor="@color/sc_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_agent_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_bg"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/sc_text_mid"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_agent_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_agent_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>

    <TextView
        android:id="@+id/tv_agent_run_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sc_panel"
        android:fontFamily="monospace"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@color/sc_accent"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="思考中 · 1s"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sc_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/et_agent_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="@string/agent_input_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="@color/sc_text"
            android:textColorHint="@color/sc_text_dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_agent_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_outline_accent"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="@string/agent_stop"
            android:textAllCaps="false"
            android:textColor="@color/sc_accent"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_agent_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_inventory_primary"
            android:minWidth="0dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="@string/agent_send"
            android:textAllCaps="false"
            android:textColor="@color/sc_ink"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
